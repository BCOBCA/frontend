{
  "expo": {
    "name": "Báo chí Online BCA",
    "slug": "bcobca",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bcobca.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bcobca.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-secure-store",
      ["expo-image-picker", { "photosPermission": "Cho phép chọn ảnh đại diện và ảnh bìa từ thư viện ảnh.", "cameraPermission": false, "microphonePermission": false }]
    ],
    "scheme": "bcobca"
  }
}
